---
import { PRACTICE_AREAS_NAV, SITE_CONFIG } from '../data/siteConfig';

const currentPath = Astro.url.pathname;
const isHindi = currentPath.startsWith('/hi');
---

<header
  class="sticky top-0 z-40 border-b border-border-subtle bg-paper transition-colors shadow-md"
>
  <!-- Signature Orange-Amber-Yellow Luminous Accent Bar -->
  <div class="brand-gradient-bar h-1 w-full" aria-hidden="true"></div>

  <!-- Top Statutory Information Bar -->
  <div class="bg-ink text-xs text-white border-b border-zinc-800">
    <div
      class="mx-auto flex max-w-container flex-wrap items-center justify-between gap-2 px-4 py-1.5 sm:px-6 lg:px-8"
    >
      <p class="font-medium tracking-wide text-zinc-300">
        <span class="font-semibold text-amber-400"
          >Pan-India Corporate &amp; Litigation Counsel</span
        >
        <span class="mx-2 hidden text-orange-500 sm:inline" aria-hidden="true">•</span>
        <span class="hidden md:inline">{SITE_CONFIG.bciDisclaimerShort}</span>
      </p>
      <div class="flex items-center gap-3 sm:gap-4">
        <a
          href={`mailto:${SITE_CONFIG.nap.email}`}
          class="hidden font-medium text-zinc-300 hover:text-amber-300 xl:inline"
        >
          {SITE_CONFIG.nap.email}
        </a>
        <span class="hidden text-zinc-700 xl:inline" aria-hidden="true">|</span>
        <a
          href={`tel:${SITE_CONFIG.nap.phoneE164}`}
          class="font-semibold text-amber-300 hover:text-orange-400"
        >
          {SITE_CONFIG.nap.phoneDisplay}
        </a>
        <span class="text-zinc-700" aria-hidden="true">|</span>
        <a
          href={isHindi ? '/' : '/hi/'}
          hreflang={isHindi ? 'en-IN' : 'hi-IN'}
          class="font-semibold text-orange-400 hover:text-amber-300 hover:underline"
          aria-label={isHindi ? 'Switch to English' : 'हिंदी में पढ़ें'}
        >
          {isHindi ? 'English' : 'हिंदी (HI)'}
        </a>
        <button
          type="button"
          id="theme-toggle"
          class="rounded border border-zinc-700 bg-zinc-900 px-2 py-0.5 text-zinc-200 hover:border-amber-400 hover:text-amber-300"
          aria-label="Toggle color theme"
        >
          <span id="theme-toggle-label">Theme</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div
    class="mx-auto flex max-w-container items-center justify-between gap-3 px-4 py-2.5 sm:gap-4 sm:px-6 sm:py-3 lg:px-8"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-3 rounded bg-white px-2.5 py-1 shadow-sm ring-1 ring-zinc-200/80 focus:outline-none dark:ring-amber-500/40"
      aria-label="Zodiac Legal Home"
    >
      <img
        src="/brand/logo.png"
        alt="Zodiac Legal — Advocates & Corporate Counsel"
        width="179"
        height="90"
        class="h-10 w-auto sm:h-12"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Primary Navigation" class="hidden items-center gap-7 lg:flex">
      <a
        href="/about/"
        class:list={[
          'text-sm font-medium transition-colors hover:text-brass',
          currentPath.startsWith('/about') ? 'text-brass font-bold' : 'text-content-primary',
        ]}
      >
        About
      </a>

      <!-- Accessible Practice Areas Mega-Menu Disclosure -->
      <div class="relative" id="mega-menu-container">
        <button
          type="button"
          id="mega-menu-trigger"
          aria-expanded="false"
          aria-controls="mega-menu-panel"
          class:list={[
            'inline-flex items-center gap-1.5 text-sm font-medium transition-colors hover:text-brass',
            currentPath.startsWith('/practice-areas')
              ? 'text-brass font-bold'
              : 'text-content-primary',
          ]}
        >
          <span>Practice Areas</span>
          <svg
            class="h-4 w-4 transition-transform duration-150"
            id="mega-menu-chevron"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"></path>
          </svg>
        </button>

        <div
          id="mega-menu-panel"
          hidden
          class="absolute right-0 left-auto mt-4 w-[44rem] -translate-x-1/4 overflow-hidden rounded-md border border-border-strong bg-paper-card p-6 shadow-2xl"
        >
          <div class="brand-gradient-bar absolute inset-x-0 top-0 h-1" aria-hidden="true"></div>
          <div class="mb-4 flex items-center justify-between border-b border-border-subtle pb-3">
            <div>
              <p class="font-serif text-base font-semibold text-content-primary">
                Corporate, Commercial &amp; Litigation Practice Desks
              </p>
              <p class="text-xs text-content-muted">Structured legal representation across India</p>
            </div>
            <a href="/practice-areas/" class="text-xs font-bold text-brass hover:underline">
              View All 9 Practice Areas →
            </a>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {
              PRACTICE_AREAS_NAV.map((area) => (
                <a
                  href={`/practice-areas/${area.slug}/`}
                  class="group rounded border border-transparent p-2.5 transition-colors hover:border-orange-500/40 hover:bg-paper-warm"
                >
                  <p class="font-serif text-sm font-semibold text-content-primary group-hover:text-brass">
                    {area.title}
                  </p>
                  <p class="mt-0.5 text-xs leading-snug text-content-secondary">{area.shortDesc}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <a
        href="/team/"
        class:list={[
          'text-sm font-medium transition-colors hover:text-brass',
          currentPath.startsWith('/team') ? 'text-brass font-bold' : 'text-content-primary',
        ]}
      >
        Our Team
      </a>

      <a
        href="/insights/"
        class:list={[
          'text-sm font-medium transition-colors hover:text-brass',
          currentPath.startsWith('/insights') ? 'text-brass font-bold' : 'text-content-primary',
        ]}
      >
        Insights
      </a>

      <a
        href="/faq/"
        class:list={[
          'text-sm font-medium transition-colors hover:text-brass',
          currentPath.startsWith('/faq') ? 'text-brass font-bold' : 'text-content-primary',
        ]}
      >
        FAQ
      </a>

      <a
        href="/contact/"
        class:list={[
          'text-sm font-medium transition-colors hover:text-brass',
          currentPath.startsWith('/contact') ? 'text-brass font-bold' : 'text-content-primary',
        ]}
      >
        Contact
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact/#consultation-form"
        class="btn-primary hidden rounded-sm bg-gradient-to-r from-orange-600 via-orange-500 to-amber-500 px-5 py-2.5 text-xs font-bold tracking-wider text-white uppercase shadow-md transition-all hover:from-amber-500 hover:to-yellow-400 hover:text-black sm:inline-flex"
      >
        Book a Consultation
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        class="inline-flex items-center justify-center rounded border border-border-strong p-2 text-content-primary lg:hidden"
        aria-label="Open main navigation menu"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.75"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Panel -->
  <nav
    id="mobile-nav-drawer"
    aria-label="Mobile Navigation"
    hidden
    class="max-h-[calc(100dvh-7.5rem)] overflow-y-auto overscroll-contain border-t border-border-subtle bg-paper px-4 pt-3 pb-20 lg:hidden"
  >
    <div class="flex flex-col space-y-2">
      <a
        href="/about/"
        class="rounded px-2 py-2 text-base font-medium text-content-primary hover:bg-paper-warm"
      >
        About the Firm
      </a>
      <a
        href="/practice-areas/"
        class="rounded px-2 py-2 text-base font-medium text-content-primary hover:bg-paper-warm"
      >
        All Practice Areas
      </a>
      <div class="border-s-2 border-orange-500 ps-3 space-y-1.5 py-1">
        {
          PRACTICE_AREAS_NAV.map((area) => (
            <a
              href={`/practice-areas/${area.slug}/`}
              class="block py-1 text-sm text-content-secondary hover:text-brass"
            >
              {area.title}
            </a>
          ))
        }
      </div>
      <a
        href="/team/"
        class="rounded px-2 py-2 text-base font-medium text-content-primary hover:bg-paper-warm"
      >
        Our Team (Shalini Pandey, Sakshi Pandey, Shiv Kumar Pandey)
      </a>
      <a
        href="/insights/"
        class="rounded px-2 py-2 text-base font-medium text-content-primary hover:bg-paper-warm"
      >
        Legal Insights (10 Guides)
      </a>
      <a
        href="/faq/"
        class="rounded px-2 py-2 text-base font-medium text-content-primary hover:bg-paper-warm"
      >
        FAQs
      </a>
      <a
        href="/contact/"
        class="rounded px-2 py-2 text-base font-medium text-content-primary hover:bg-paper-warm"
      >
        Contact &amp; Location
      </a>
      <div class="pt-2">
        <a
          href="/contact/#consultation-form"
          class="block w-full rounded-sm bg-gradient-to-r from-orange-600 to-amber-500 py-3 text-center text-xs font-bold tracking-wider text-white uppercase"
        >
          Book a Consultation
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const storedTheme = localStorage.getItem('zl_theme');
    if (storedTheme === 'dark' || storedTheme === 'light') {
      document.documentElement.setAttribute('data-theme', storedTheme);
    }

    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = current ? current === 'dark' : prefersDark;
        const next = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('zl_theme', next);
      });
    }

    const megaTrigger = document.getElementById('mega-menu-trigger');
    const megaPanel = document.getElementById('mega-menu-panel');
    const megaContainer = document.getElementById('mega-menu-container');
    const megaChevron = document.getElementById('mega-menu-chevron');

    function closeMegaMenu() {
      if (!megaTrigger || !megaPanel) return;
      megaTrigger.setAttribute('aria-expanded', 'false');
      megaPanel.hidden = true;
      megaChevron?.classList.remove('rotate-180');
    }

    if (megaTrigger && megaPanel) {
      megaTrigger.addEventListener('click', () => {
        const expanded = megaTrigger.getAttribute('aria-expanded') === 'true';
        megaTrigger.setAttribute('aria-expanded', String(!expanded));
        megaPanel.hidden = expanded;
        megaChevron?.classList.toggle('rotate-180', !expanded);
      });

      document.addEventListener('click', (e) => {
        if (megaContainer && !megaContainer.contains(e.target)) {
          closeMegaMenu();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMegaMenu();
      });
    }

    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');

    function closeMobileDrawer() {
      if (!mobileBtn || !mobileDrawer) return;
      mobileBtn.setAttribute('aria-expanded', 'false');
      mobileDrawer.hidden = true;
    }

    if (mobileBtn && mobileDrawer) {
      mobileBtn.addEventListener('click', () => {
        const expanded = mobileBtn.getAttribute('aria-expanded') === 'true';
        mobileBtn.setAttribute('aria-expanded', String(!expanded));
        mobileDrawer.hidden = expanded;
      });

      mobileDrawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeMobileDrawer();
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMobileDrawer();
      });
    }
  })();
</script>
