---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { PRACTICE_AREAS_NAV, SITE_CONFIG } from '../data/siteConfig';

const nationalFaqs = [
  {
    question: 'Which courts and tribunals across India handle commercial and corporate disputes?',
    answer:
      'Commercial disputes in India are adjudicated before the Commercial Courts and Commercial Divisions of High Courts (for specified value disputes under the Commercial Courts Act, 2015), State High Courts for writ, arbitration (Section 11/37), and appellate matters, Debts Recovery Tribunals (DRT) for banking recovery, and State RERA Authorities for real estate disputes. Insolvency and corporate governance matters under the IBC and Companies Act are heard at the jurisdictional benches of the National Company Law Tribunal (NCLT).',
  },
  {
    question: 'How are companies incorporated and regulated across India under the MCA?',
    answer:
      'Name reservation and SPICe+ (INC-32) incorporation forms are processed centrally through the Ministry of Corporate Affairs (MCA) Central Registration Centre (CRC), while ongoing statutory filings, charge registrations, and compliance monitoring are overseen by the respective jurisdictional Registrar of Companies (ROC).',
  },
  {
    question:
      'Can Zodiac Legal assist enterprises across multiple Indian states with corporate transactions, arbitration, or RERA matters?',
    answer:
      'Yes. We regularly represent enterprises headquartered in Delhi-NCR, Mumbai, Bengaluru, Hyderabad, Chennai, Pune, Kolkata, and across India in corporate governance, commercial contract structuring, domestic arbitration, RERA proceedings, NCLT insolvency petitions, and 30-year property title due diligence.',
  },
];
---

<BaseLayout
  title="Pan-India Corporate & Commercial Lawyers | Zodiac Legal"
  description="Pan-India corporate, commercial contract, RERA, arbitration, and debt recovery legal practice advising enterprises and institutions across India."
  canonicalPath="/corporate-lawyers-in-lucknow/"
  lastReviewed="2026-10-16"
>
  <section class="hero-obsidian-glow py-14 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[{ label: 'Pan-India Corporate Practice', href: '/corporate-lawyers-in-lucknow/' }]}
        invertText={true}
      />
      <p class="text-xs font-semibold tracking-widest text-amber-400 uppercase">
        National Practice Guide • Pan-India Jurisdiction
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        Pan-India Corporate &amp; Commercial Legal Representation
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-300">
        A comprehensive guide to commercial courts, regulatory authorities, corporate compliance,
        and statutory dispute resolution for enterprises operating across India.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="legal-prose min-w-0 lg:col-span-8">
          <h2>How does the corporate and commercial legal framework operate across India?</h2>
          <p>
            India’s commercial and regulatory architecture is governed by central statutes—including
            the <strong>Companies Act, 2013</strong>, the <strong>Indian Contract Act, 1872</strong
            >, the <strong>Insolvency and Bankruptcy Code, 2016 (IBC)</strong>, the{' '}
            <strong>Arbitration and Conciliation Act, 1996</strong>, the{' '}
            <strong>Commercial Courts Act, 2015</strong>, and the{' '}
            <strong>Real Estate (Regulation and Development) Act, 2016 (RERA)</strong>—adjudicated
            through specialized benches of the High Courts, Commercial Courts, National Company Law
            Tribunal (NCLT), Debts Recovery Tribunals (DRT), and State RERA Authorities.
          </p>
          <p>
            <strong>Zodiac Legal</strong> advises domestic and multinational corporations, startups, promoters,
            institutional lenders, and commercial stakeholders across India’s primary business corridors—providing
            seamless contract architecture, regulatory filings, and multi-forum litigation representation.
          </p>

          <h2>Key Judicial &amp; Regulatory Forums Across India</h2>
          <div class="overflow-x-auto">
            <table>
              <thead>
                <tr>
                  <th>Forum / Authority</th>
                  <th>Primary Statutory Jurisdiction</th>
                  <th>Territorial Scope</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Supreme Court &amp; High Courts</strong></td>
                  <td>
                    Constitutional writs (Art. 32/226), Sec. 11/37 arbitration matters, commercial
                    appeals
                  </td>
                  <td>Pan-India &amp; State Benches</td>
                </tr>
                <tr>
                  <td><strong>Commercial Courts &amp; Divisions</strong></td>
                  <td>
                    Specified-value commercial disputes under Commercial Courts Act, 2015 &amp; Sec.
                    9/34 Arbitration
                  </td>
                  <td>All Major Commercial Districts</td>
                </tr>
                <tr>
                  <td><strong>State RERA Authorities &amp; REAT</strong></td>
                  <td>
                    Real estate project registration, possession delay interest, refunds &amp;
                    appeals
                  </td>
                  <td>State-Wise Benches Nationwide</td>
                </tr>
                <tr>
                  <td><strong>Debts Recovery Tribunals (DRT / DRAT)</strong></td>
                  <td>
                    SARFAESI Act, 2002 Sec. 17 applications &amp; RDB Act financial recovery
                    petitions
                  </td>
                  <td>Regional Benches Across India</td>
                </tr>
                <tr>
                  <td><strong>National Company Law Tribunal (NCLT)</strong></td>
                  <td>
                    Corporate insolvency (IBC Sec. 7, 9) &amp; Companies Act mergers/oppression
                  </td>
                  <td>Principal &amp; Regional Benches</td>
                </tr>
                <tr>
                  <td><strong>Ministry of Corporate Affairs (MCA / ROC)</strong></td>
                  <td>
                    Central Registration Centre (CRC) incorporations, annual ROC filings &amp;
                    charges
                  </td>
                  <td>Centralized Digital &amp; State ROCs</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2>Core Corporate &amp; Litigation Services Offered Nationwide</h2>
          <ul>
            {
              PRACTICE_AREAS_NAV.map((area) => (
                <li>
                  <a
                    href={`/practice-areas/${area.slug}/`}
                    class="font-semibold text-brass underline"
                  >
                    {area.title}
                  </a>
                  : {area.shortDesc}
                </li>
              ))
            }
          </ul>

          <div class="mt-10">
            <h2>Frequently Asked Questions — Pan-India Corporate Representation</h2>
            <FaqAccordion items={nationalFaqs} groupName="national-faq" emitSchema={true} />
          </div>

          <p class="mt-8 text-xs text-content-muted">
            <em>
              Last Reviewed: 16 October 2026 • Reviewed by {SITE_CONFIG.name} Pan-India Corporate &amp;
              Litigation Desk. Informational only; not legal advice.
            </em>
          </p>
        </div>

        <aside class="lg:col-span-4">
          <ConsultationForm compact={true} />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
