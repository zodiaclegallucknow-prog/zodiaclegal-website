---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ConsultationForm from '../../components/ConsultationForm.astro';
import { SITE_CONFIG } from '../../data/siteConfig';
import { buildServiceSchema } from '../../utils/schema';

export async function getStaticPaths() {
  const areas = await getCollection('practice-areas');
  return areas.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'practice-areas'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allInsights = await getCollection('insights');
const relatedInsightEntries = allInsights.filter((post) =>
  entry.data.relatedInsights.includes(post.slug)
);

const pageUrl = new URL(`/practice-areas/${entry.slug}/`, SITE_CONFIG.url).toString();
const serviceSchema = buildServiceSchema({
  name: entry.data.title,
  description: entry.data.summary,
  url: pageUrl,
});
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.metaDescription}
  canonicalPath={`/practice-areas/${entry.slug}/`}
  lastReviewed={entry.data.lastReviewed}
  extraSchema={serviceSchema}
>
  <!-- Header Banner -->
  <section class="hero-obsidian-glow py-14 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: 'Practice Areas', href: '/practice-areas/' },
          { label: entry.data.title, href: `/practice-areas/${entry.slug}/` },
        ]}
        invertText={true}
      />
      <p class="text-xs font-semibold tracking-widest text-amber-400 uppercase">
        {entry.data.category} • Pan-India Practice
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-300">
        {entry.data.summary}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-stone-400">
        <span>Last Reviewed: {entry.data.lastReviewed}</span>
        <span aria-hidden="true">•</span>
        <span>Reviewed by: {entry.data.reviewedBy}</span>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-18">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <!-- Main Content Column -->
        <div class="min-w-0 lg:col-span-8">
          <!-- Direct Answer Summary Box for AEO/GEO -->
          <div class="mb-10 rounded border-s-4 border-brass bg-paper-warm p-6">
            <p class="text-xs font-semibold tracking-wider text-brass uppercase">
              Practice Scope Summary
            </p>
            <p class="mt-2 text-base leading-relaxed font-medium text-content-primary">
              {entry.data.directAnswer}
            </p>
          </div>

          <!-- Typical Client Situations -->
          <div class="mb-10">
            <h2 class="font-serif text-2xl font-semibold text-content-primary">
              When do clients engage our {entry.data.title} desk?
            </h2>
            <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {
                entry.data.typicalSituations.map((situation) => (
                  <li class="card-surface flex items-start gap-2.5 rounded border border-border-subtle bg-paper-card p-4 text-sm text-content-secondary">
                    <span class="font-bold text-brass" aria-hidden="true">
                      ▪
                    </span>
                    <span>{situation}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Substantial Markdown Body (600-1,000 words) -->
          <div class="legal-prose">
            <Content />
          </div>

          <!-- Step-by-Step Process -->
          <div class="mt-12 border-t border-border-subtle pt-10">
            <h2 class="font-serif text-2xl font-semibold text-content-primary">
              How We Handle {entry.data.title} Mandates
            </h2>
            <ol class="mt-6 space-y-4">
              {
                entry.data.processSteps.map((stepObj, idx) => (
                  <li class="card-surface rounded border border-border-subtle bg-paper-card p-5">
                    <div class="flex items-baseline gap-3">
                      <span class="font-mono text-xs font-bold text-brass">STEP 0{idx + 1}</span>
                      <h3 class="font-serif text-lg font-semibold text-content-primary">
                        {stepObj.step}
                      </h3>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-content-secondary">
                      {stepObj.detail}
                    </p>
                  </li>
                ))
              }
            </ol>
          </div>

          <!-- Documents Required Checklist -->
          <div class="mt-12 rounded border border-border-strong bg-paper-warm p-6">
            <h2 class="font-serif text-xl font-semibold text-content-primary">
              Documents Commonly Required for Initial Review
            </h2>
            <p class="mt-1 text-xs text-content-secondary">
              Having the following records ready accelerates conflict checks and statutory analysis:
            </p>
            <ul class="mt-4 space-y-2 text-sm text-content-secondary">
              {
                entry.data.documentsNeeded.map((doc) => (
                  <li class="flex items-start gap-2.5">
                    <span class="font-bold text-brass" aria-hidden="true">
                      ✓
                    </span>
                    <span>{doc}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Practice-Specific FAQs (with FAQPage Schema) -->
          <div class="mt-12 border-t border-border-subtle pt-10">
            <h2 class="font-serif text-2xl font-semibold text-content-primary mb-6">
              Frequently Asked Questions — {entry.data.title}
            </h2>
            <FaqAccordion
              items={entry.data.faqs}
              groupName={`faq-${entry.slug}`}
              emitSchema={true}
            />
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="space-y-8 lg:col-span-4">
          <div class="card-surface rounded border border-border-strong bg-paper-card p-6">
            <h2 class="font-serif text-lg font-semibold text-content-primary">
              Statutes &amp; Enactments Covered
            </h2>
            <ul class="mt-3 space-y-2 text-xs leading-relaxed text-content-secondary">
              {
                entry.data.statutesCovered.map((statute) => (
                  <li class="flex items-start gap-2">
                    <span class="text-brass" aria-hidden="true">
                      •
                    </span>
                    <span>{statute}</span>
                  </li>
                ))
              }
            </ul>

            <h2
              class="mt-6 font-serif text-lg font-semibold text-content-primary border-t border-border-subtle pt-5"
            >
              Relevant Forums &amp; Authorities
            </h2>
            <ul class="mt-3 space-y-2 text-xs leading-relaxed text-content-secondary">
              {
                entry.data.forumsCovered.map((forum) => (
                  <li class="flex items-start gap-2">
                    <span class="text-brass" aria-hidden="true">
                      •
                    </span>
                    <span>{forum}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            relatedInsightEntries.length > 0 && (
              <div class="card-surface rounded border border-border-subtle bg-paper-warm p-6">
                <h2 class="font-serif text-lg font-semibold text-content-primary">
                  Related Statutory Guides
                </h2>
                <ul class="mt-4 space-y-3">
                  {relatedInsightEntries.map((post) => (
                    <li class="border-b border-border-subtle pb-3 last:border-none last:pb-0">
                      <a
                        href={`/insights/${post.slug}/`}
                        class="font-serif text-sm font-semibold text-content-primary hover:text-brass"
                      >
                        {post.data.title}
                      </a>
                      <p class="mt-1 text-xs text-content-muted">{post.data.readingTime}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <ConsultationForm defaultPracticeArea={entry.slug} compact={true} />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
